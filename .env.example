# === Mail Configuration ===
MAIL_FROM="your-email@gmail.com"
MONTHLY_REPORT_MAIL_TO="report-recipient@gmail.com"
SALARY_MAIL_CC=
SUPPORT_EMAIL="support@gmail.com"
FROM_EMAIL="your-email@gmail.com"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"
EMAIL_HOST="smtp.gmail.com"
ADMIN_EMAIL="admin@gmail.com"
SALARY_MAIL_TO="salary-recipient@gmail.com"
TEST_EMAIL="test-recipient@gmail.com"

# === Authentication ===
JWT_SECRET="generate-a-random-base64-secret-here"
CRON_SECRET="generate-a-random-cron-secret-here"

# === Database ===
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=yourapp&retryWrites=true&w=majority"

# === AWS S3 (Image Storage) ===
S3_ACCESS_KEY="your-aws-access-key-id"
S3_SECRET_ACCESS_KEY="your-aws-secret-access-key"
S3_REGION="eu-north-1"
S3_BUCKET_NAME="your-bucket-name"

# === AI (Google Gemini) ===
GEMINI_API_KEY="your-gemini-api-key"
